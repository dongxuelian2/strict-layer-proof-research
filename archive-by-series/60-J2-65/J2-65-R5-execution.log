===== J2-65-R5-ReciprocalTube.py =====
R5 RECIPROCAL TUBE CERTIFICATE
RECIPROCAL_TUBE_IDENTITY=PASS
IDENTITY=u-rho^-1=(rho*G-(q-rho))/(q*rho)
SHALLOW_LAW=PROVED_BY_DISTINCT_VALUATION_ULTRAMETRIC: r<g => v_p(u-rho^-1)=r
SUPERCRITICAL_LAW=PROVED_BY_DISTINCT_VALUATION_ULTRAMETRIC: r>g => v_p(u-rho^-1)=g
