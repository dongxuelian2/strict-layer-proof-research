===== J2-65-R5-CyclotomicComplement.py =====
R5 CYCLOTOMIC COMPLEMENT CERTIFICATE
STRUCTURAL_RELATION=uq=10^g+1
FINITE_DEPTH_RECIPROCAL_CONGRUENCE=PROVED
PROOF: m<=g => 10^g=0 mod p^m => qu=1 mod p^m; q is a p-unit, hence u=q^-1 mod p^m
RECIP: q=rho mod p^m => u=rho^-1 mod p^m
A_TUBE_TRANSFER=PROVED: p=5 same depth; p=2 depth gains exactly 1 under A=2u+1
BDET_TRANSFER=PROVED: v5(Bdet-q)=g; v2(Bdet-q)=g+1 for Bdet=2*10^g+q
CYCLOTOMIC_ORDER_THEOREM=PROVED
ORDER_PROOF: if n=ord_q(10), order of 10^g is n/gcd(n,g)=2 because 10^g=-1 mod q and q is odd; set d=gcd(n,g), then n=2d, d|g, gcd(2,g/d)=1, so g/d is odd
Q_PRIME_ASSUMED=FALSE
ORD_q_EQ_2g_ASSUMED=FALSE
COMPOSITE_q_ALLOWED=TRUE
CYCLOTOMIC_BLOCK_ASSUMPTION_q_DIVIDES_Phi_2g=FALSE

