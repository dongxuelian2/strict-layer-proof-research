t=s*r
x=s*y
Ntail=s*Nhat(r), Nhat= (G + q**3*r - 2*q**2*r - 12*q*r - 8*r)/(q*(q**3 + 10*q**2 + 12*q + 8))
Z=s*Zhat(r), Zhat= (-2*G + 2*q**4*r*u + q**4*r + 20*q**3*r*u + 8*q**3*r + 24*q**2*r*u + 16*q**2*r + 16*q*r*u + 32*q*r + 16*r)/(q**2*(q + 4)*(q**3 + 10*q**2 + 12*q + 8))
a3=s*a3hat(r), a3hat= (G*q**3*r + 10*G*q**2*r + 12*G*q*r + 8*G*r - G - 2*q**3*r - 8*q**2*r)/(2*(q + 4)*(q**3 + 10*q**2 + 12*q + 8))
Xrad=s*Xhat(r), Xhat= (G*q**2*u + 4*G*q*u - 2*G + q**5*r*u + 4*q**4*r*u + q**4*r + 8*q**3*r - 32*q**2*r*u + 16*q**2*r - 16*q*r*u + 32*q*r + 16*r)/(2*q**2*(q + 4)*(q**3 + 10*q**2 + 12*q + 8))
D2=s*Dhat(r), Dhat= (G**2*q**2*u + 4*G**2*q*u - 2*G**2 + 2*G*q**5*r*u + 14*G*q**4*r*u + G*q**4*r + 12*G*q**3*r*u + 8*G*q**3*r - 24*G*q**2*r*u + 16*G*q**2*r - G*q**2*u - 16*G*q*r*u + 32*G*q*r + 16*G*r - 2*q**5*r*u - 8*q**4*r*u)/(2*q**2*(q + 4)*(q**3 + 10*q**2 + 12*q + 8))
DHAT_DEGREE_IN_r= 1
SHARED_D_PROJECTIVE_CONTENT=NONE
