===== J2-65-R19-IsotropicVeronese.py =====
RATIONAL_ISOTROPIC_BASEPOINT=WITNESS_DEPENDENT
BASEPOINT_CONDITION=pR^2-D0*pV^2-F0*N0*pH^2=0
ISOTROPIC_VERONESE_MAP:
R= -D*pR*t**2 + 2*D*pV*s*t - pR*s**2
V= D*pV*t**2 - 2*pR*s*t + pV*s**2
H= pH*(-D*t**2 + s**2)
VERONESE_DEGREE=2
IDENTITY=Q0(F(s,t))=(s^2-D0*t^2)^2*Q0(p)
PROJECTIVE_PARAMETERIZATION=PROVED_ON_TRANSVERSE_CHART
INTEGRAL_PARAMETERIZATION=PROVED_AFTER_CLEARING_ONE_BASEPOINT_DENOMINATOR; PRIMITIVE_NORMALIZATION_REQUIRES_CONTENT
PRIMITIVE_CONTENT_FUNCTION=gcd(F_R(s,t),F_V(s,t),F_H(s,t))
RETURN_CODE=0
