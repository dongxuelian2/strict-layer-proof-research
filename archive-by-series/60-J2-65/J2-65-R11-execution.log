===== J2-65-R11-ContinuedFraction.py =====
RETURN_CODE=0
R(n)=[[-n,1],[1,0]]
PRODUCT_3= [[-n0 - n2*(n0*n1 + 1), n0*n1 + 1], [n1*n2 + 1, -n1]]
CONTINUANT_RECURRENCE:
P_-1=0,P_0=1; R_-1=1,R_0=0
P_{j+1}=-n_j P_j+P_{j-1}
R_{j+1}=-n_j R_j+R_{j-1}
M_j=[[P_j,P_{j-1}],[R_j,R_{j-1}]]
GAUSSIAN_CF_MATCHES_REDUCTION=PROVED_AS_HERMITIAN_CF; STANDARD_NEAREST_CF=PARTIAL

===== J2-65-R11-DiagonalMap.py =====
RETURN_CODE=0
DIAGONAL_1= -(re(p) - im(p) - im(r))*im(r) + I*((re(p) - im(p) - im(r))*re(r) - re(p)*re(r) + re(r)*im(p) + re(r)*im(r)) + 2*re(p)*re(r) - re(p)*im(r) + re(r)**2 + 2*re(r)*im(p) + im(p)*im(r)
DIAGONAL_2= -(re(q) - im(q) - im(s))*im(s) + I*((re(q) - im(q) - im(s))*re(s) - re(q)*re(s) + re(s)*im(q) + re(s)*im(s)) + 2*re(q)*re(s) - re(q)*im(s) + re(s)**2 + 2*re(s)*im(q) + im(q)*im(s)
EXACT_FORMULA:
Phi(x,y)=|y|^2+2 Re((1+i) conjugate(x) y)
If X=(reduction_word * terminal_normalizer)^(-1),
Dplus=Phi(X11,X21), Dminus=Phi(X12,X22).
The entries of X are Gaussian continuants by the two-term recurrence.
DIAGONAL_MAP_IN_CONTINUANT_COORDINATES=PROVED

