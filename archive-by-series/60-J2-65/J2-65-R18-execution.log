===== J2-65-R18-CompositionAdapted.py =====
CAS_IDENTITY=PASS
R^2+(J0*V)^2=N0*(W0*V^2+F0*H^2)
Q_AUX=W0*V^2+F0*H^2
Q_AUX_CONTENT=gcd(W0,F0)
Q_AUX_DISCRIMINANT=-4*W0*F0
Q_AUX_POSITIVE=TRUE
COMPOSITION_ADAPTED_SOURCE_COORDINATES=NOT_FOUND
RETURN_CODE=0

===== J2-65-R18-CyclotomicSaturation.py =====
CYCLOTOMIC_SOURCE_SATURATION=PROVED
DEFINITION=legal row-equivalence/saturation inside the fixed boundary coordinate lattice
OLD_CONGRUENCE=G | d*(hZ*Z+ha*a)
NEW_EQUIVALENT_CONGRUENCE=G | 2*d*(1+4u)*(Z+u*(1+2u)^3*a)
WHY_EQUIVALENT=multiply the congruence row by u^5, a unit modulo G
delta_old=gcd(G,2*d*(q+4))
delta0=gcd(G,2*d*(1+4u))
delta_old=delta0 because gcd(u,G)=1 and u*(q+4)=G+1+4u
SATURATION_QUOTIENT=0
SATURATION_QUOTIENT_ORDER=1
PRIME_FACTORIZATION_USED=FALSE
RETURN_CODE=0

===== J2-65-R18-DigitShellPullback.py =====
R16_exact: Rpartial=2*d0*a+d1*h
d0=400*q^10*D0
R=r0=Rpartial/(800*q^5)
lambda_h=d1/(800*q^5)  # exact R16 normalized h-row coefficient
therefore R=q^5*D0*a+lambda_h*h
H=MU0*h, MU0=20*G^2*q^4*(G+1)
CONTACT_HEIGHT_IN_AMBIENT_COORDINATES=h=H/MU0
DIGIT_HEIGHT_IN_AMBIENT_COORDINATES=a=(R-lambda_h*H/MU0)/(q^5*D0)
DIGIT_HEIGHT_FUNCTIONAL_q_DEPENDENCE=SCALAR_ONLY
Q_FREE_DIGIT_SHELL=PARTIAL
REASON=ambient quadratic coefficients are q-free, but the legal integral height section retains recovered q-scales
PRIMITIVE_MOD_u_GATE_REOPENED=FALSE
JACOBSTHAL_CAMPAIGN_REOPENED=FALSE
RETURN_CODE=0

===== J2-65-R18-EmbeddedSourceLattice.py =====
BOUNDARY_QFREE_BASIS_COLUMNS:
(M0,0,0),(rho0,1,-A),(0,0,10)
M0=G/gcd(G,2*d*(1+4u))
rho0 == -u*(1+2u)^3 (mod M0)
R16_PRE_EXTRA_ROWS: r0=r_a*a+r_h*h; v0=v_Z*Z+v_a*a+v_h*h
QFREE_EMBEDDING_MATRIX_ROWS:
[0, r_a-A*r_h, 10*r_h]
[q^2*v_Z*M0, q^2*(v_Z*rho0+v_a-A*v_h), 10*q^2*v_h]
[0, -A*MU0, 10*MU0]
CONTACT_HEIGHT_LINE=MU0*Z inside the chosen ambient lattice
UNIVERSAL_ORDER_PACKET=Z/q^2Z
DECIMAL_AMBIENT_SOURCE_PACKET=Z/M0Z direct_sum Z/q^2Z
gcd(M0,q)=1 => DECIMAL_AMBIENT_SOURCE_PACKET ~= Z/(M0*q^2)Z
RETURN_CODE=0

===== J2-65-R18-FinitePacket.py =====
CANONICAL_AMBIENT=retain the fixed decimal chart and the contact-height line
SOURCE_CONGRUENCE_PACKET=Z/M0Z
SCHUR_CONDUCTOR_PACKET=Z/q^2Z
gcd(M0,q)=1 because M0|G and gcd(q,G)=1
FINITE_SOURCE_PACKET=Z/M0Z direct_sum Z/q^2Z ~= Z/(M0*q^2)Z
FINITE_PACKET_RANK=0
FINITE_PACKET_INVARIANT_FACTORS=(M0*q^2)
FINITE_PACKET_ORDER=M0*q^2
FINITE_PACKET_AUTOMATIC_ON_AMBIENT_ISOTROPIC_LOCUS=UNRESOLVED
SOURCE_PACKET_IS_CURRENT_J2_OBSTRUCTION=TRUE
RAW_Z3_LEDGER: with g10=gcd(M0,10), boundary SNF=(1,g10,10*M0/g10)
adding coprime q^2 conductor gives raw invariant factors=(1,g10,q^2*10*M0/g10)
RETURN_CODE=0

===== J2-65-R18-PowerTenAmbient.py =====
TORIC_BASE=G=10^g,K=10^k,0<k<2g,u|(G+1),q=(G+1)/u>1
deg_G(F0)=2; deg_K(F0)=0
deg_G(N0)=2; deg_K(N0)=2
deg_G(W0)=4; deg_K(W0)=0
deg_G(S0)=3; deg_K(S0)=1
deg_G(D0)=6; deg_K(D0)=2
deg_G(F0*N0)=4; deg_K(F0*N0)=2
Q0_COEFFICIENT_GCD=1 because coefficient of R^2 is 1
UNIVERSAL_TEN_POWER_CONTENT=1
Q10_PRIM=Q0
FURTHER_SOURCE_LEGAL_TEN_SQUARE_DESCENT=NONE
RETURN_CODE=0

===== J2-65-R18-QFreeAmbient.py =====
MU0= 20*G**2*q**4*(G + 1)
MU0_INTEGRAL=TRUE
AMBIENT_COORDINATES=R=r0; V=q^2*v0; H=MU0*h
Q_FREE_AMBIENT_FORM=R^2-D0*V^2-F0*N0*H^2
Q_FREE_AMBIENT_COEFFICIENTS_DEPEND_ONLY_ON_G_u_K=TRUE
NOTE=C_extra is avoided by using the pre-extra R16 coordinates (r0,v0)
RETURN_CODE=0

